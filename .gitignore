# Игнорировать временные и большие бинарные файлы

# Python cache
__pycache__/
*.py[cod]

# Virtualenvs
venv/
env/
.venv/

# IDE / Editor
.vscode/
.vs/

# Build outputs
**/bin/
**/obj/
build/
dist/

# Python packaging
*.egg-info/
pip-wheel-metadata/
*.egg

# Large data, models, artifacts
artifacts/
artifacts/**
rocket-builder-ml-*/
*.pt
*.pth
*.h5
*.onnx
*.ckpt

# Dataset / generated data
data/
data/**

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# CUDA local builds or folders inside repo
cuda/
cuda-*
nvcc.out

# Archives
*.zip
*.tar.gz
*.tar
*.rar

# Additional large/OS/library files
cudatoolkit/
*.cubin
*.ptx

# Native libraries and large binaries
*.dll
*.so
*.dylib

# IDE
.idea/

# Temporary
*.tmp
*.swp

# If you need to store large model or binary files in the repo, consider Git LFS:
#   git lfs install
#   git lfs track "*.pt"
# Then commit the generated .gitattributes file instead of ignoring tracked patterns.
