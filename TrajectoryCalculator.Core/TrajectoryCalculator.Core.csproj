<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TrajectoryCalculator</PackageId>
    <Version>1.0.0</Version>
    <Authors>Xleb4ikk</Authors>
    <Description>A library for planning interplanetary transfer windows using Lambert's problem and porkchop-plot analysis. Supports single-transfer, batch, and dataset-generation workflows.</Description>
    <PackageProjectUrl>https://github.com/Xleb4ikk/TransferWindowPlanner-master</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xleb4ikk/TransferWindowPlanner-master.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ksp;trajectory;lambert;porkchop;orbital-mechanics;transfer-window</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
