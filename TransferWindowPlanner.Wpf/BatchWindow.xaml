<Window x:Class="TrajectoryCalculator.Gui.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Calculation" Width="1280" Height="820" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" FontFamily="Segoe UI"
        Foreground="#D4D4D4">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9DA0A8"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="RunButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#x1F4E6;" FontSize="20" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText" Text="Batch Calculation" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="LblSource" Text="Source" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblInputPath" Text="Folder or manifest:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" x:Name="InputPathBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="BtnBrowseFolder" Content="Folder&#x2026;" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Click="BrowseFolder_Click"/>
                    <Button Grid.Column="3" x:Name="BtnBrowseManifest" Content="Manifest&#x2026;" Style="{StaticResource ToolButton}" Click="BrowseManifest_Click"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LblOutputDir" Text="Output folder:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" x:Name="OutputDirBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="BtnBrowseOutput" Content="&#x2026;" Style="{StaticResource ToolButton}" Width="32" Margin="0,0,16,0" Click="BrowseOutput_Click"/>
                    <CheckBox Grid.Column="3" x:Name="ChkRecursive" Content="Recursive" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#D4D4D4"/>
                    <TextBlock Grid.Column="4" x:Name="LblMaxParallel" Text="Parallel:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="5" x:Name="MaxParallelBox" Style="{StaticResource FieldBox}" Width="48" Text="4"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnRun" Content="&#x25B6; Run batch" Style="{StaticResource RunButton}" Click="Run_Click"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource CancelButton}" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                    <ProgressBar x:Name="RunProgress" Width="260" Height="20" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="#9DA0A8" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3E3E42" BorderThickness="1"
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3E3E42">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="Padding" Value="6,0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,2"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="140"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#6A9955"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Success}" Value="False">
                                    <Setter Property="Foreground" Value="#F44336"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="70"/>
                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="90"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="90"/>
                <DataGridTextColumn Header="Departure" Binding="{Binding DepartureDate}" Width="150"/>
                <DataGridTextColumn Header="Travel time" Binding="{Binding TravelDuration}" Width="120"/>
                <DataGridTextColumn Header="dV transfer" Binding="{Binding DVTransferTotal, StringFormat={}{0:0} m/s}" Width="100"/>
                <DataGridTextColumn Header="dV mission" Binding="{Binding MissionTotalDeltaV, StringFormat={}{0:0} m/s}" Width="100"/>
                <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs, StringFormat={}{0:0}}" Width="60"/>
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Foreground="#9DA0A8" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnExportCsv" Content="Export CSV&#x2026;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button x:Name="BtnExportJson" Content="Export JSON&#x2026;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button x:Name="BtnOpenOutputFolder" Content="Open output folder" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Click="OpenOutputFolder_Click"/>
            <Button x:Name="BtnClose" Content="Close" Style="{StaticResource ToolButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
