<Window x:Class="TrajectoryCalculator.Gui.RocketBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rocket Builder AI" Width="1460" Height="940" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" FontFamily="Segoe UI"
        Foreground="#D4D4D4">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9DA0A8"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
        </Style>
        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="SectionBox" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="14,8,14,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnPredict" Content="Predict" Width="140" Height="34" Margin="0,0,8,0"
                        Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand" Click="OnPredict"/>
                <Button x:Name="BtnLoadJson" Content="Load Request JSON" Width="160" Height="34" Margin="0,0,8,0"
                        Background="#3E3E42" Foreground="#D4D4D4" BorderThickness="0" Click="OnLoadJson"/>
                <Button x:Name="BtnSaveJson" Content="Save Request JSON" Width="160" Height="34" Margin="0,0,20,0"
                        Background="#3E3E42" Foreground="#D4D4D4" BorderThickness="0" Click="OnSaveJson"/>
                <TextBlock Text="Default model:" VerticalAlignment="Center" Foreground="#9DA0A8" Margin="0,0,6,0"/>
                <TextBlock x:Name="DefaultModelLabel" VerticalAlignment="Center" Foreground="#6A9955" FontFamily="Consolas" FontSize="12"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Padding="16,16,8,16" Background="#1E1E1E">
                <StackPanel>
                    <Border Style="{StaticResource SectionBox}" Background="#2D2D30">
                        <StackPanel>
                            <TextBlock Text="Neural rocket architect on top of your trained model" FontWeight="SemiBold" FontSize="14" Foreground="#D4D4D4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="#9DA0A8">This screen keeps Surface→Orbit, Orbit→TMI, MOI, and correction reserve separate while still building a compatible rocket_builder_ml request.</TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Runtime"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ModelCombo" Grid.Row="0" Grid.Column="1" Margin="0,2,0,6" Height="30" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42" SelectionChanged="OnFieldChanged"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Device" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DeviceCombo" Grid.Row="1" Grid.Column="1" Margin="0,2,0,6" Height="30" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42" SelectionChanged="OnFieldChanged"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Top candidates" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TopKBox" Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource FieldBox}" TextChanged="OnFieldChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Mission basics"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Origin planet" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="OriginCombo" Grid.Row="0" Grid.Column="1" Margin="0,2,0,6" Height="30" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination planet" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DestCombo" Grid.Row="1" Grid.Column="1" Margin="0,2,0,6" Height="30" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Payload mass, kg" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PayloadBox" Grid.Row="2" Grid.Column="1" Text="1000" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Travel days" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TravelDaysBox" Grid.Row="3" Grid.Column="1" Text="250" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mean solar distance, AU" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MeanDistBox" Grid.Row="4" Grid.Column="1" Text="1.0" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Min solar distance, AU" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MinDistBox" Grid.Row="5" Grid.Column="1" Text="1.0" Style="{StaticResource FieldBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Mission delta-v budget"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mission total (excl. reserve), m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DvTotalBox" Grid.Row="0" Grid.Column="1" Text="10000" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Surface→Orbit, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SurfaceOrbitBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Orbit→TMI, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="OrbitTmiBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="MOI / arrival burn, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MoiBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Correction reserve dV, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CorrectionBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Departure stack subtotal, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DepartureStackBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Breakdown total, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BreakdownTotalBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Total incl. reserve, m/s" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AllocationTotalBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Trajectory context"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Departure orbit, km" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepOrbitBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrival orbit, km" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ArrOrbitBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Departure distance, AU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepDistBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Arrival distance, AU" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ArrDistBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Departure solar flux, W/m^2" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepFluxBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Mean solar flux, W/m^2" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MeanFluxBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Phase angle, deg" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhaseAngleBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Transfer angle, deg" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TransferAngleBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Long-way mode" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LongWayCombo" Grid.Row="8" Grid.Column="1" Margin="0,2,0,6" Height="30" Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Prepared request"/>
                            <TextBox x:Name="RequestJsonBox" Style="{StaticResource CodeBox}" MinHeight="180" AcceptsReturn="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="4" Background="#3E3E42" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <TabControl Background="#1E1E1E" BorderThickness="0">
                    <TabItem Header="Best design" Background="#2D2D30" Foreground="#D4D4D4">
                        <Border Background="#1E1E1E" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionBox}" Margin="0,0,6,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Best architecture"/>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Architecture key" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestArchBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mission stages" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestStagesBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Effective stages" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestEffStagesBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Interpretation" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestInterpretBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Predicted score, kg-eq" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestScoreBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Predicted launch mass, kg" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestMassBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Predicted boiloff, kg" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestBoiloffBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Inference device" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BestDeviceBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SectionBox}" Margin="6,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Why this design"/>
                                            <TextBox x:Name="ReasoningBox" Style="{StaticResource CodeBox}" MinHeight="220"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource SectionBox}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Stage breakdown"/>
                                        <DataGrid x:Name="StagesGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="150"
                                                  Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42"
                                                  RowHeaderWidth="0" AlternatingRowBackground="#252526"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#3E3E42"/><Setter Property="Foreground" Value="#D4D4D4"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="28"/></Style>
                                                <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#D4D4D4"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="50"/>
                                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
                                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                                <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="90"/>
                                                <DataGridTextColumn Header="Fuel" Binding="{Binding Fuel}" Width="120"/>
                                                <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="130"/>
                                                <DataGridTextColumn Header="Engines" Binding="{Binding Engines}" Width="65"/>
                                                <DataGridTextColumn Header="Thrust,kN" Binding="{Binding ThrustKn,StringFormat=N0}" Width="80"/>
                                                <DataGridTextColumn Header="Isp,s" Binding="{Binding IspS,StringFormat=N1}" Width="65"/>
                                                <DataGridTextColumn Header="Tank,kg" Binding="{Binding TankKg,StringFormat=N0}" Width="80"/>
                                                <DataGridTextColumn Header="dV,m/s" Binding="{Binding DvMps,StringFormat=N0}" Width="80"/>
                                                <DataGridTextColumn Header="dV,%" Binding="{Binding DvPct,StringFormat=N1}" Width="65"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Alternatives" Background="#2D2D30" Foreground="#D4D4D4">
                        <Border Background="#1E1E1E" Padding="12">
                            <Border Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Top candidates"/>
                                    <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="300"
                                              Background="#2D2D30" Foreground="#D4D4D4" BorderBrush="#3E3E42"
                                              RowHeaderWidth="0" AlternatingRowBackground="#252526"
                                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#3E3E42"/><Setter Property="Foreground" Value="#D4D4D4"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="28"/></Style>
                                            <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#D4D4D4"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/></Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50"/>
                                            <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="240"/>
                                            <DataGridTextColumn Header="Stages" Binding="{Binding Stages}" Width="140"/>
                                            <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveStages}" Width="70"/>
                                            <DataGridTextColumn Header="Score" Binding="{Binding Score,StringFormat=N0}" Width="100"/>
                                            <DataGridTextColumn Header="Engineering" Binding="{Binding EngineeringScore,StringFormat=N0}" Width="100"/>
                                            <DataGridTextColumn Header="Launch Mass" Binding="{Binding LaunchMass,StringFormat=N0}" Width="100"/>
                                            <DataGridTextColumn Header="Boiloff" Binding="{Binding Boiloff,StringFormat=N0}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Border>
                    </TabItem>
                    <TabItem Header="Response JSON" Background="#2D2D30" Foreground="#D4D4D4">
                        <Border Background="#1E1E1E" Padding="12">
                            <TextBox x:Name="ResponseJsonBox" Style="{StaticResource CodeBox}"/>
                        </Border>
                    </TabItem>
                    <TabItem Header="Console" Background="#2D2D30" Foreground="#D4D4D4">
                        <Border Background="#1E1E1E" Padding="12">
                            <TextBox x:Name="ConsoleBox" Style="{StaticResource CodeBox}"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#2D2D30" Padding="14,6">
            <TextBlock x:Name="StatusText" Foreground="#9DA0A8" FontSize="12" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
