<Window x:Class="TransferWindowPlanner.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solar System Transfer Planner"
        Height="920" Width="1480"
        MinHeight="640" MinWidth="1080"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardSectionStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="RunButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSuccessBrush}"/>
            <Setter Property="Padding" Value="28,10"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="RocketButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentWarningBrush}"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Explicit keyed references to implicit styles (for backward compat with XAML references) -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"/>
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderTitle"
                               Text="Transfer Window Planner"
                               Style="{StaticResource HeadingMediumStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnSingleTemplate" Content="Single Template" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" Margin="0,0,6,0" Click="SingleTemplate_Click"/>
                    <Button x:Name="BtnPorkchopTemplate" Content="Porkchop Template" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" Margin="0,0,6,0" Click="PorkchopTemplate_Click"/>
                    <Button x:Name="BtnOpenJson" Content="Open JSON" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" Margin="0,0,6,0" Click="OpenJson_Click"/>
                    <Button x:Name="BtnSaveJson" Content="Save JSON" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" Margin="0,0,6,0" Click="SaveJson_Click"/>
                    <Button x:Name="BtnRun" Content="► Run" Style="{StaticResource RunButtonStyle}"
                            Margin="0,0,6,0" Click="RunCalculation_Click"/>
                    <Button x:Name="BtnRocketBuilder" Content="AI Rocket Builder" Style="{StaticResource RocketButtonStyle}"
                            Click="RocketBuilder_Click"/>
                    <Button x:Name="BtnBatch" Content="Batch Calculation" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,7" Margin="6,0,0,0" Click="Batch_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblLanguage" Text="Language:" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource ModernComboBoxStyle}"
                              Width="120" SelectionChanged="Language_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT PANEL ========== -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- Info Card -->
                    <Border Style="{StaticResource CardSectionStyle}" Background="{StaticResource CardBrush}">
                        <StackPanel>
                            <TextBlock x:Name="InfoHeading"
                                       Text="Solar System Planner"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="InfoBody"
                                       Text="Pre-configured with JPL ephemeris data for Mercury through Neptune. Enter UTC mission times for trajectory calculations."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Mission Card -->
                    <Border Style="{StaticResource CardSectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CardMission" Text="Mission" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblOrigin" Style="{StaticResource FieldLabelStyle}">Origin Planet</TextBlock>
                            <ComboBox x:Name="OriginCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblDestination" Style="{StaticResource FieldLabelStyle}">Destination Planet</TextBlock>
                            <ComboBox x:Name="DestinationCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12" SelectionChanged="Destination_SelectionChanged"/>

                            <TextBlock x:Name="LblMode" Style="{StaticResource FieldLabelStyle}">Calculation Mode</TextBlock>
                            <ComboBox x:Name="ModeCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12" SelectionChanged="Mode_SelectionChanged"/>

                            <TextBlock x:Name="LblTrajectory" Style="{StaticResource FieldLabelStyle}">Trajectory</TextBlock>
                            <ComboBox x:Name="LongWayCombo" Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Transfer Card (Single) -->
                    <Border x:Name="SingleCard" Style="{StaticResource CardSectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CardTransfer" Text="Transfer Schedule" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblDepartureDate" Style="{StaticResource FieldLabelStyle}">Departure Date (UTC)</TextBlock>
                            <DatePicker x:Name="DepartureDatePicker"
                                        Style="{StaticResource ModernDatePickerStyle}"
                                        Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblTravelDays" Style="{StaticResource FieldLabelStyle}">Travel Time (days)</TextBlock>
                            <TextBox x:Name="TravelDaysBox" Text="220" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Porkchop Card -->
                    <Border x:Name="PorkchopCard" Style="{StaticResource CardSectionStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CardPorkchop" Text="Porkchop Scan" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblWindowStart" Style="{StaticResource FieldLabelStyle}">Window Start (UTC)</TextBlock>
                            <DatePicker x:Name="WindowStartPicker" Style="{StaticResource ModernDatePickerStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblWindowEnd" Style="{StaticResource FieldLabelStyle}">Window End (UTC)</TextBlock>
                            <DatePicker x:Name="WindowEndPicker" Style="{StaticResource ModernDatePickerStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblTravelMin" Style="{StaticResource FieldLabelStyle}">Min Travel (days)</TextBlock>
                            <TextBox x:Name="TravelMinBox" Text="120" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblTravelMax" Style="{StaticResource FieldLabelStyle}">Max Travel (days)</TextBlock>
                            <TextBox x:Name="TravelMaxBox" Text="360" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="LblDepSteps" Style="{StaticResource FieldLabelStyle}">Departure Steps</TextBlock>
                                    <TextBox x:Name="DepartureStepsBox" Text="48" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblTravelSteps" Style="{StaticResource FieldLabelStyle}">Travel Steps</TextBlock>
                                    <TextBox x:Name="TravelStepsBox" Text="48" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Parking Orbits Card -->
                    <Border Style="{StaticResource CardSectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CardParking" Text="Parking Orbits" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="LblDepPeriapsis" Style="{StaticResource FieldLabelStyle}">Departure Periapsis (km)</TextBlock>
                                    <TextBox x:Name="DepPeriapsisBox" Text="200" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblDepApoapsis" Style="{StaticResource FieldLabelStyle}">Departure Apoapsis (km)</TextBlock>
                                    <TextBox x:Name="DepApoapsisBox" Text="200" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LblArrivalMode" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4">Arrival Mode</TextBlock>
                            <ComboBox x:Name="ArrivalModeCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblArrivalOrbit" Style="{StaticResource FieldLabelStyle}">Arrival Orbit (km)</TextBlock>
                            <TextBox x:Name="ArrivalOrbitBox" Text="250" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="AerobrakingCheck"
                                      Content="Use Aerobraking"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>
                            <TextBlock x:Name="AerobrakingNote"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Launch Config Card -->
                    <Border Style="{StaticResource CardSectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CardLaunch" Text="Launch Configuration" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblMissionStart" Style="{StaticResource FieldLabelStyle}">Mission Start</TextBlock>
                            <ComboBox x:Name="LaunchEnabledCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12" SelectionChanged="LaunchEnabled_Changed"/>

                            <TextBlock x:Name="LblLaunchCalc" Style="{StaticResource FieldLabelStyle}">Launch Calculation</TextBlock>
                            <ComboBox x:Name="LaunchModeCombo" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="LblMass" Style="{StaticResource FieldLabelStyle}">Mass (kg)</TextBlock>
                                    <TextBox x:Name="LaunchMassBox" Text="500000" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblThrust" Style="{StaticResource FieldLabelStyle}">Thrust (MN)</TextBlock>
                                    <TextBox x:Name="LaunchThrustBox" Text="7" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LblIsp" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4">ISP (sec)</TextBlock>
                            <TextBox x:Name="LaunchIspBox" Text="310" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="LblLatitude" Style="{StaticResource FieldLabelStyle}">Latitude (°)</TextBlock>
                                    <TextBox x:Name="LaunchLatBox" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblLongitude" Style="{StaticResource FieldLabelStyle}">Longitude (°)</TextBlock>
                                    <TextBox x:Name="LaunchLonBox" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="LblInclination" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4">Inclination (°)</TextBlock>
                            <TextBox x:Name="LaunchInclBox" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Output Files Card -->
                    <Border Style="{StaticResource CardSectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CardOutput" Text="Output Files" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblCsvPath" Style="{StaticResource FieldLabelStyle}">CSV Output Path</TextBlock>
                            <TextBox x:Name="CsvPathBox" Text="data/results/earth-mars-porkchop.csv" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="LblResultJson" Style="{StaticResource FieldLabelStyle}">Result JSON Path</TextBlock>
                            <TextBox x:Name="ResultPathBox" Text="data/results/result.json" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardSectionStyle}" Background="Transparent"
                            BorderThickness="0" Padding="0" Height="8"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ========== RIGHT PANEL ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="MainTabControl" Grid.Row="0"
                            Background="Transparent"
                            BorderThickness="0"
                            TabStripPlacement="Top"
                            SelectionChanged="TabControl_SelectionChanged">

                    <TabItem x:Name="TabSummary" Header="Summary">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <TextBox x:Name="SummaryBox"
                                     Style="{StaticResource SummaryTextBoxStyle}"
                                     Text=""/>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabDeltaVVisual" Header="Delta-V Visual">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Delta-V header cards -->
                            <Border x:Name="DeltaVHeader" Grid.Row="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Card 1: Total dV -->
                                    <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock x:Name="DvTotalLabel" Text="Total dV"
                                                       Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="DvTotalValue" Text="---"
                                                       Style="{StaticResource HeadingLargeStyle}"
                                                       Foreground="{StaticResource AccentSuccessBrush}"/>
                                            <TextBlock Text="m/s" Style="{StaticResource MutedTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Card 2: Ejection dV -->
                                    <Border Grid.Column="1" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock x:Name="DvEjectionLabel" Text="Ejection dV"
                                                       Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="DvEjectionValue" Text="---"
                                                       Style="{StaticResource HeadingLargeStyle}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="m/s" Style="{StaticResource MutedTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Card 3: Insertion dV -->
                                    <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock x:Name="DvInsertionLabel" Text="Insertion dV"
                                                       Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="DvInsertionValue" Text="---"
                                                       Style="{StaticResource HeadingLargeStyle}"
                                                       Foreground="{StaticResource AccentWarningBrush}"/>
                                            <TextBlock Text="m/s" Style="{StaticResource MutedTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Info block -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="160">
                                        <TextBlock x:Name="DvDepartureInfo" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock x:Name="DvTravelInfo" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock x:Name="DvPhaseInfo" Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Visual content area -->
                            <Grid Grid.Row="1">
                                <Image x:Name="DeltaVImage" Stretch="Uniform"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <TextBlock x:Name="DeltaVEmptyText"
                                           Text="Run a calculation to see the minimum delta-v."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TabSolarSystem" Header="Solar System">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,0,12,0">
                                <Grid>
                                    <Canvas x:Name="SolarCanvas" ClipToBounds="True"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <TextBlock x:Name="SolarEmptyText"
                                               Text="Run a calculation to see the departure geometry."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" MinWidth="200" MaxWidth="260"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel x:Name="SolarInfoPanel">
                                    <TextBlock x:Name="SolarTitle" Style="{StaticResource HeadingSmallStyle}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="SolarPhaseInfo" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SolarDepartureInfo" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SolarTravelInfo" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SolarLongWayInfo" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="SolarShowAllCheck" Content="Show all planets"
                                              Foreground="{StaticResource TextMutedBrush}"
                                              Margin="0,0,0,12"
                                              Checked="SolarShowAll_Changed" Unchecked="SolarShowAll_Changed"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Legend" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="SolarLegend"/>
                                    <TextBlock x:Name="SolarNote" Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TabScenarioJson" Header="Scenario JSON">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <TextBox x:Name="ScenarioJsonBox"
                                     Style="{StaticResource CodeTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabResultJson" Header="Result JSON">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <TextBox x:Name="ResultJsonBox"
                                     Style="{StaticResource CodeTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Written Files -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblWrittenFiles" Text="Written Files" Style="{StaticResource HeadingSmallStyle}" Margin="0,0,0,6"/>
                        <TextBox x:Name="WrittenFilesBox"
                                 Style="{StaticResource CodeTextBoxStyle}"
                                 MinHeight="40" MaxHeight="80"
                                 IsReadOnly="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center"
                           Text="Ready"/>
                <TextBlock Grid.Column="1"
                           x:Name="CurrentFileText"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400"/>
            </Grid>
        </Border>
    </Grid>
</Window>
